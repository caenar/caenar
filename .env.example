# Required to protect /admin in production.
ADMIN_SECRET=replace-with-a-long-random-secret

# Fine-grained GitHub token with Contents: read and write for this repository.
GITHUB_TOKEN=
GITHUB_OWNER=caenar
GITHUB_REPO=caenar
GITHUB_BRANCH=master

# Optional. A GitHub push already triggers the connected Vercel project;
# set this only when an explicit deploy hook is desired.
VERCEL_DEPLOY_HOOK_URL=
